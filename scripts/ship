#!/usr/bin/env bash
# usage: scripts/ship <url>
# Ships this commit to the pool on Fly (fly.toml) and keeps it only if a real Claude reply comes back whole through
# <url> (scripts/check); otherwise the image that ran before goes back.
set -euo pipefail
url=${1:?usage: scripts/ship <url>}
cd "$(dirname "$0")/.."
app=$(sed -n 's/^app = "\(.*\)"/\1/p' fly.toml)
before=$(fly image show --app "$app" --json | jq -r '.[0] | "\(.Registry)/\(.Repository)@\(.Digest)"')
fly deploy --remote-only --wait-timeout 5m
if scripts/check "$url"; then
  echo "ship: $(git log -1 --format='%h %s') is live on $app"
  exit 0
fi
echo "ship: undoing $(git log -1 --format=%h) on $app" >&2
fly deploy --image "$before" --wait-timeout 5m
exit 1
